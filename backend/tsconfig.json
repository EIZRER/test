{
  "compilerOptions": {
    "target": "ES2020",                       // Use ES2020 for better async/await support
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",              // 👈 ensure Node-style module resolution
    "types": ["node", "express"]             // 👈 include types for Node.js and Express
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
